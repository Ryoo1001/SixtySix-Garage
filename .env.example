# Environment Variables untuk Sixty6Garage
# Salin file ini ke .env.local dan isi dengan nilai yang benar

# =============================================
# DATABASE (Supabase PostgreSQL)
# Dapatkan dari: Supabase Dashboard → Connect → Transaction Pooler
# =============================================
DATABASE_URL=postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres

# =============================================
# BETTER AUTH
# BETTER_AUTH_SECRET: buat string random min. 32 karakter
# BETTER_AUTH_URL: URL domain produksi (Vercel) atau http://localhost:3001 untuk dev
# =============================================
BETTER_AUTH_SECRET=isi_dengan_string_random_panjang_minimal_32_karakter
BETTER_AUTH_URL=https://your-domain.vercel.app
